{
  "hosting": {
    "target": "training",
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "test/**", "README.md"],
    "headers": [
      { "source": "**/*.@(html|js|mjs|css|webmanifest)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(wasm|task|tflite)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
    ]
  }
}
